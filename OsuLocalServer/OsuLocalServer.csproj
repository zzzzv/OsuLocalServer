<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishDir>..\publish\</PublishDir>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Version>0.5.2</Version>
  </PropertyGroup>

  <!--
    lazer 的 osu.Game / osu.Framework / Realm 引用（以及 OsuLazer.Interop 源码本身）
    由 OsuLazer.Interop 包的 buildTransitive props 提供，无需在此重复声明。
  -->

  <!-- publish 后在输出文件名中追加版本号 -->
  <Target Name="AddVersionToPublishOutput" AfterTargets="Publish" Condition="'$(Version)' != ''">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName)-$(Version).exe" Condition="Exists('$(PublishDir)$(AssemblyName).exe')" />
    <Move SourceFiles="$(PublishDir)$(AssemblyName).pdb" DestinationFiles="$(PublishDir)$(AssemblyName)-$(Version).pdb" Condition="Exists('$(PublishDir)$(AssemblyName).pdb')" />
  </Target>

  <ItemGroup>
    <!-- 0.1.1 起包的 props 放在 build/（不是 buildTransitive/），不会传递到引用本项目的工程，
         所以这里不需要 PrivateAssets="all" 也不会出现 CS0436。 -->
    <PackageReference Include="OsuLazer.Interop" Version="0.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只有本项目的 mania 相关任务需要直接使用 mania mod 类型 -->
    <Reference Include="osu.Game.Rulesets.Mania">
      <HintPath>$(OsuLazerCurrentDir)\osu.Game.Rulesets.Mania.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="StarRatingRebirth" Version="0.1.1" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="zzzzv.OsuParsers" Version="1.7.2" />
    <PackageReference Include="zzzzv.SPMRating" Version="1.2.0" />
  </ItemGroup>

</Project>
